# ==============================================================================
# LandAssist — Environment Configuration Template (.env.example)
#
# Petunjuk:
# 1. Salin file ini menjadi `.env` di root repository:
#      cp .env.example .env            # Linux / macOS
#      Copy-Item .env.example .env     # Windows PowerShell
# 2. Isi nilai kredensial Anda di file `.env`.
# 3. File `.env` bersifat RAHASIA dan otomatis di-ignore oleh Git (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGIS CONFIGURATION (Supabase / Local Docker)
# ------------------------------------------------------------------------------
# Opsi A: Supabase Supavisor Connection Pooler (Port 6543 / Transaction Mode) — DIREKOMENDASIKAN!
# Mendukung koneksi IPv4 penuh (aman untuk ISP Indonesia & Google Cloud Run).
# Catatan: Jika password mengandung simbol spesial (@, #, $, dll.), karakter tersebut WAJIB di-URL-encode!
# Helper URL encode: python scripts/test_db_connection.py --encode-password "PasswordLu"
DATABASE_URL=postgresql://postgres.ldfkevffrmokxvznerkl:[YOUR_ENCODED_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Opsi B: Supabase Direct Connection (Port 5432 — Memerlukan dukungan IPv6 pada jaringan Anda)
# DATABASE_URL=postgresql://postgres:[YOUR_ENCODED_PASSWORD]@db.ldfkevffrmokxvznerkl.supabase.co:5432/postgres

# Opsi C: Local PostGIS via Docker Compose (docker-compose up -d)
# DATABASE_URL=postgresql://landassist:landassist_secret@localhost:5432/landassist

# Kredensial untuk docker-compose.yml lokal (jika memakai database container lokal)
POSTGRES_USER=landassist
POSTGRES_PASSWORD=landassist_secret
POSTGRES_DB=landassist

# ------------------------------------------------------------------------------
# 2. GOOGLE EARTH ENGINE (GEE) & SATELLITE EMBEDDING INGESTION
# ------------------------------------------------------------------------------
# Google Cloud Project ID yang sudah mengaktifkan Earth Engine API
EE_PROJECT_ID=

# Kredensial Service Account Earth Engine:
# Bisa diisi dengan PATH file JSON lokal (misal: credentials.json) ATAU RAW JSON STRING dari service account key
EE_SERVICE_ACCOUNT_KEY=credentials.json

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI STUDIO (Antigravity Code Review SDK)
# ------------------------------------------------------------------------------
# API Key untuk menjalankan review PR otomatis dan audit kode via scripts/agy_code_review.py
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. FASTAPI BACKEND & PRODUCTION SERVING
# ------------------------------------------------------------------------------
# Port aplikasi lokal (Google Cloud Run otomatis menyuntikkan PORT=8080)
PORT=8000

# Versi model semantic default yang disajikan ke OSM Rapid Editor (memungkinkan instant rollback)
DEFAULT_MODEL_VERSION=v1.0.0

# CORS Allowed Origins (* untuk mengizinkan OpenStreetMap Rapid Editor https://rapideditor.org)
ALLOWED_ORIGINS=*

# Filter luas minimum poligon dalam meter persegi (default: 1600 m² = 16 piksel Sentinel-2 10m)
MIN_AREA_SQM=1600.0

# ------------------------------------------------------------------------------
# 5. MODEL WEIGHTS REGISTRY & CI/CD DEPLOYMENT
# ------------------------------------------------------------------------------
# Direktori lokal untuk menyimpan bobot model SegFormer 64-channel (.pt)
WEIGHTS_DIR=weight

# Repositori GitHub Releases untuk sinkronisasi bobot model binary
GITHUB_RELEASE_REPO=Anovvy/LandAssist

# GitHub Personal Access Token (opsional, jika ingin mengunggah bobot via scripts/manage_weights.py)
GITHUB_TOKEN=

# URL Webhook trigger deployment zero-downtime untuk Cloud Run / Fly.io / Render
DEPLOY_WEBHOOK_URL=
