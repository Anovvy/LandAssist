# ==============================================================================
# LandAssist — Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to `.env` in the repository root:
#      cp .env.example .env            # Linux / macOS
#      Copy-Item .env.example .env     # Windows PowerShell
# 2. Fill in your credentials in the `.env` file.
# 3. The `.env` file contains sensitive secrets and is git-ignored (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGIS CONFIGURATION (Supabase / Local Docker)
# ------------------------------------------------------------------------------
# Option A: Supabase Supavisor Connection Pooler (Port 6543 / Transaction Mode) — RECOMMENDED!
# Full IPv4 support (reliable across all ISPs and Google Cloud Run).
# Note: If password contains special characters (@, #, $, etc.), it MUST be URL-encoded!
# Helper URL encode utility: python scripts/test_db_connection.py --encode-password "MyP@ssw0rd!"
DATABASE_URL=postgresql://postgres.ldfkevffrmokxvznerkl:[YOUR_ENCODED_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Option B: Supabase Direct Connection (Port 5432 — Requires full IPv6 network support)
# DATABASE_URL=postgresql://postgres:[YOUR_ENCODED_PASSWORD]@db.ldfkevffrmokxvznerkl.supabase.co:5432/postgres

# Option C: Local PostGIS via Docker Compose (docker compose up -d)
# DATABASE_URL=postgresql://landassist:landassist_secret@localhost:5432/landassist

# Credentials for local docker-compose.yml (when using local database container)
POSTGRES_USER=landassist
POSTGRES_PASSWORD=landassist_secret
POSTGRES_DB=landassist

# ------------------------------------------------------------------------------
# 2. GOOGLE EARTH ENGINE (GEE) & SATELLITE EMBEDDING INGESTION
# ------------------------------------------------------------------------------
# Google Cloud Project ID with Earth Engine API enabled
EE_PROJECT_ID=

# Earth Engine Service Account Credentials:
# Can be local JSON file path (e.g. credentials.json) OR RAW JSON STRING from service account key
EE_SERVICE_ACCOUNT_KEY=credentials.json

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI STUDIO (Antigravity Code Review SDK)
# ------------------------------------------------------------------------------
# API Key for automated PR reviews and code audits via scripts/agy_code_review.py
# Obtain free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. FASTAPI BACKEND & PRODUCTION SERVING
# ------------------------------------------------------------------------------
# Local application port (Google Cloud Run automatically injects PORT=8080)
PORT=8000

# Default semantic model version served to OSM Rapid Editor (enables instant rollback)
DEFAULT_MODEL_VERSION=v1.0.0

# CORS Allowed Origins (* allows OpenStreetMap Rapid Editor https://rapideditor.org)
ALLOWED_ORIGINS=*

# Minimum polygon area filter in square meters (default: 1600 m² = 16 pixels Sentinel-2 10m)
MIN_AREA_SQM=1600.0

# ------------------------------------------------------------------------------
# 5. MODEL WEIGHTS REGISTRY & CI/CD DEPLOYMENT
# ------------------------------------------------------------------------------
# Local directory for storing SegFormer 64-channel model weights (.pt)
WEIGHTS_DIR=weight

# GitHub Releases repository for syncing binary model weights
GITHUB_RELEASE_REPO=Anovvy/LandAssist

# GitHub Personal Access Token (optional, for uploading weights via scripts/manage_weights.py)
GITHUB_TOKEN=

# Production zero-downtime deployment webhook trigger URL (Cloud Run / Fly.io / Render)
DEPLOY_WEBHOOK_URL=
