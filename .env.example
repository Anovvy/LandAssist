# ==============================================================================
# LandAssist — Environment Configuration (.env.example)
# Copy this file to `.env` and fill in your credentials before running locally.
# ==============================================================================

# Supabase / PostgreSQL + PostGIS Connection URL
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Default Semantic Model Version Served by the API & ML Pipeline (enables instant rollback)
DEFAULT_MODEL_VERSION=v1.0.0

# Local Directory & GitHub Releases Repository for Versioned 64-Channel SegFormer Weights
WEIGHTS_DIR=weight
GITHUB_RELEASE_REPO=Anovvy/LandAssist

# CORS Allowed Origins (comma-separated or * for OpenStreetMap Rapid Editor)
ALLOWED_ORIGINS=*

# Minimum Area Filter in Square Meters (default: 1600 m² = 16 Sentinel-2 pixels)
MIN_AREA_SQM=1600.0
